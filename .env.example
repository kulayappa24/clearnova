# SmartClean Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# Application Mode
# ============================================
APP_MODE=DEMO  # DEMO or PRODUCTION

# ============================================
# Backend (Spring Boot)
# ============================================
DATABASE_URL=jdbc:postgresql://localhost:5432/smartclean
DATABASE_USERNAME=smartclean
DATABASE_PASSWORD=your_password_here
JWT_SECRET=your-jwt-secret-key-must-be-at-least-32-characters-long
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
AI_SERVICE_URL=http://localhost:8000

# ============================================
# Frontend (Vite/React)
# ============================================
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_APP_ENV=development
VITE_APP_MODE=DEMO

# ============================================
# AI Service (FastAPI)
# ============================================
MODEL_PATH=trained_models/waste_classifier.onnx
CONFIDENCE_THRESHOLD=0.60
MARGIN_THRESHOLD=0.15
MAX_ENTROPY=0.70
MODEL_VERSION=waste-classifier-v1
DEV_MODE=true
LOG_PREDICTIONS=true
